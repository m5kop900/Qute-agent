<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for a notarized Qute Agent build.
     - Qt Quick's QML engine uses JIT: allow-jit / unsigned-executable-memory.
     - TerminalLauncher starts Terminal via osascript: automation.apple-events.
     All Qt frameworks and plugins must be signed with the SAME Developer ID before the app. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
